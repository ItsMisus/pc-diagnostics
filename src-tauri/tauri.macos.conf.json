{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "PC Diagnostics",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 26 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "shortDescription": "Monitoraggio hardware, benchmark e diagnostica per macOS",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 ItsMisus and PC Diagnostics contributors. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "macos/it.lproj/InfoPlist.strings"
      }
    }
  }
}
